# Public hostname without scheme. Keep localhost for the container health check.
WF_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],forensics.example.org
# Public HTTPS origin, no trailing slash. Configure TLS at your reverse proxy.
WF_TRUSTED_ORIGINS=https://forensics.example.org
WF_HTTPS=1
WF_PORT=8000
WF_WORKERS=2

# Optional shared HTTP Basic login. 1 = enabled, 0 = disabled (default).
# When enabled, set a long unique password. An empty password prevents startup.
WF_AUTH_ENABLED=0
WF_AUTH_USERNAME=admin
WF_AUTH_PASSWORD=
