# Local HTTP / SSH-tunnel defaults. For a public reverse proxy add your domain
# to WF_ALLOWED_HOSTS (no scheme or port), keep 127.0.0.1 for the health check.
WF_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# For public HTTPS set WF_HTTPS=1. This also tells Django the public scheme,
# even when the reverse proxy talks HTTP to the container.
WF_HTTPS=0
# Usually empty when the proxy preserves Host. If it rewrites Host, specify
# the real browser origin including scheme and optional port, no trailing slash.
WF_TRUSTED_ORIGINS=
WF_PORT=8000
WF_WORKERS=2

# Optional shared HTTP Basic login. 1 = enabled, 0 = disabled (default).
# When enabled, set a long unique password. An empty password prevents startup.
WF_AUTH_ENABLED=0
WF_AUTH_USERNAME=admin
WF_AUTH_PASSWORD=

# Optional HTTP CONNECT proxy allowing public TCP port 43 for WHOIS.
# Empty: use the inherited HTTPS proxy, if configured, otherwise connect directly.
WF_WHOIS_PROXY=
